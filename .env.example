# Copy to .env and fill in. Never commit .env (it is in .gitignore and .dockerignore).
#   cp .env.example .env
#   uvicorn app.api:create_app --factory --env-file .env --port 8000
#   docker run --env-file .env -p 8000:8000 transcription-pipeline
# Keep comments on their own lines: docker --env-file does not strip inline comments.

# --- Credentials -------------------------------------------------------------
# API key clients must send as "X-API-Key: <value>" on /transcriptions.
# Leave empty to disable auth (local dev only). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TP_API_KEY=

# OpenAI API key for the primary engine. Leave empty to run on the local
# fallback (faster-whisper) only.
OPENAI_API_KEY=

# --- Engine ------------------------------------------------------------------
# Primary engine: openai | faster-whisper | mock
TP_ENGINE=openai
# Used when the primary fails (per chunk): faster-whisper | openai | none
TP_FALLBACK_ENGINE=faster-whisper
# Skip a failing primary for this many seconds (circuit breaker)
TP_FALLBACK_COOLDOWN_S=60
TP_OPENAI_MODEL=whisper-1
# Local model (fallback):
# tiny | base | small | medium | large-v3
TP_MODEL_SIZE=base
# cpu | cuda | auto
TP_DEVICE=cpu
# float16 on GPU
TP_COMPUTE_TYPE=int8

# --- Input limits ------------------------------------------------------------
TP_MAX_UPLOAD_MB=500
TP_MAX_DURATION_S=14400
# Longer audio becomes a background job (202)
TP_SYNC_MAX_DURATION_S=120
TP_JOB_WORKERS=2

# --- Long-audio chunking -----------------------------------------------------
TP_CHUNK_SECONDS=600
TP_SILENCE_SEARCH_S=30
TP_CHUNK_OVERLAP_S=2
TP_SILENCE_NOISE_DB=-35
TP_SILENCE_MIN_S=0.5
TP_CHUNK_WORKERS=1
